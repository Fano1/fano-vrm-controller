{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "types": ["node", "vitest"]
  },
  "include": ["index.ts", "src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}